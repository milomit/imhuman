{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imhuman",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "humanid",
      // If you fork this, replace with the id printed by `npx wrangler d1 create humanid`.
      "database_id": "f036a619-6fff-452b-b638-2cdb38e53a92",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "RP_NAME": "I'm Human",
    // The live site's address. Passkeys are locked to RP_ID, so set this before real people sign up.
    // Local development overrides both in .dev.vars (written by `npm run setup`).
    "RP_ID": "imhuman.milomitm.workers.dev",
    "ORIGIN": "https://imhuman.milomitm.workers.dev",
    "VAPID_SUBJECT": "https://github.com/milomit/imhuman"
  }
  // Secrets (RECEIPT_KEY, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY) live in .dev.vars locally.
  // For production: `npm run setup -- --production secrets.json`, then `npx wrangler secret bulk secrets.json`.
}
